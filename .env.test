# Disposable local/CI test infrastructure only; these are not deployment secrets.
# Loaded explicitly by python -m scripts.test_db. Never used by normal app startup.
ENV=test
TEST_DB_ENABLED=true
TEST_DB_DATABASE=quickapi_fastapi_disposable_test
TEST_DB_USER=quickapi_fastapi_test
TEST_DB_PASSWORD=quickapi_fastapi_test_password
TEST_DB_ROOT_PASSWORD=quickapi_fastapi_test_root_password
TEST_MYSQL_PORT=3311
TEST_DATABASE_URL=mysql+asyncmy://quickapi_fastapi_test:quickapi_fastapi_test_password@127.0.0.1:3311/quickapi_fastapi_disposable_test
# Additional exact hosts permitted for dedicated CI infrastructure, comma-separated.
# TEST_DB_ALLOWED_HOSTS=
