# Disposable local/CI test infrastructure only; these are not deployment secrets.
# Loaded explicitly by python -m scripts.test_db. Never used by normal app startup.
ENV=test
TEST_DB_ENABLED=true
TEST_DB_DATABASE=quickapi_fastapi_disposable_test
TEST_DB_USER=quickapi_fastapi_test
TEST_DB_PASSWORD=quickapi_fastapi_test_password
TEST_DB_ROOT_PASSWORD=quickapi_fastapi_test_root_password
TEST_MYSQL_PORT=3311
# Database URLs must use mysql+asyncmy; other drivers are rejected.
TEST_DATABASE_URL=mysql+asyncmy://quickapi_fastapi_test:quickapi_fastapi_test_password@127.0.0.1:3311/quickapi_fastapi_disposable_test
# Additional exact hosts permitted for dedicated CI infrastructure, comma-separated.
# TEST_DB_ALLOWED_HOSTS=
# Optional dedicated TLS qualification host port; default 3312.
# TEST_TLS_PORT=3312
# Optional database policy overrides; same defaults and validation as the app.
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=50
# DB_POOL_ACQUIRE_TIMEOUT_MS=1000
# DB_CONNECT_TIMEOUT_MS=10000
# Readiness shares one on-demand probe and briefly caches both success and failure.
# Probe deadline includes acquisition and SELECT 1; cache 0 disables caching.
# DB_READINESS_TIMEOUT_MS=1000
# DB_READINESS_CACHE_MS=1000
# Startup checks migration history only; it never applies migrations automatically.
# DB_MIGRATION_CHECK_TIMEOUT_MS=5000
# Local test DB is plaintext; the tls command supplies a separate generated CA/server.
# DB_SSL=false
# Optional CA file (no default): DB_SSL_CA_FILE=/path/to/mysql-ca.pem

# Shutdown budgets in milliseconds: positive integers; drain must be less than total.
# Stop new HTTP work, drain accepted work, then clean up dependencies.
# HTTP_DRAIN_TIMEOUT_MS=25000
# SHUTDOWN_TIMEOUT_MS=30000
