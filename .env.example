APP_NAME=QuickAPI
APP_VERSION=1.0.0

ENV=development
LOG_LEVEL=DEBUG
TIMEZONE=Etc/UTC

HOST=0.0.0.0
PORT=8000

# Native Python reaches Compose MySQL through its loopback-published port.
# Inside Compose, the API overrides this URL to mysql:3306.
DATABASE_URL=mysql+asyncmy://quickapi:change-me@127.0.0.1:3308/quickapi

# Optional Compose host-port overrides; omit to use defaults 8000 and 3308.
# If supplied: integer 1-65535; empty values also use the defaults.
# PORT above controls native Python; container-internal ports remain fixed.
# API_PUBLISHED_PORT=8000
# MYSQL_PUBLISHED_PORT=3308