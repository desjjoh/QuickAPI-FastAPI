# Application identity (required).
APP_NAME=QuickAPI
APP_VERSION=1.0.0
ENV=development

# Logging: DEBUG, INFO, WARN, ERROR. Default INFO. Successful requests use DEBUG.
# Development/test: readable console. Production: structured JSON with UTC timestamps.
# INFO shows lifecycle events and hides successful requests; WARN/ERROR reduce verbosity.
# LOG_LEVEL=INFO
# IANA timezone identifier. Default Etc/UTC.
# TIMEZONE=Etc/UTC

# Native listener. HOST defaults to 0.0.0.0; PORT is required.
# Compose fixes the internal listener to 0.0.0.0:8000.
# HOST=0.0.0.0
PORT=8000

# Database (required). Dedicated quickapi-fastapi-dev Compose MySQL; separate from sibling apps.
# Native Python uses loopback port 3310. Run python -m alembic upgrade head before startup.
# Compose overrides this URL to its internal mysql:3306 service.
# Disposable MySQL tests use .env.test via python -m scripts.test_db, never this dev URL.
# Database URLs must use mysql+asyncmy; other drivers are rejected.
DATABASE_URL=mysql+asyncmy://quickapi:change-me@127.0.0.1:3310/quickapi-fastapi-dev

# Database capacity/transport (per engine/process); optional overrides, defaults shown.
# MySQL: fixed connection cap, no overflow, bounded FIFO waiters. Queue 0 rejects excess immediately.
# Connections 1-1000; waiting callers 0-10000; deadlines 1-2147483647 milliseconds.
# Acquisition covers queue wait plus usable connection setup, not SQL execution.
# The earlier acquisition/connect deadline wins during a new connection attempt.
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=50
# DB_POOL_ACQUIRE_TIMEOUT_MS=1000
# DB_CONNECT_TIMEOUT_MS=10000
# Readiness shares one on-demand probe and briefly caches both success and failure.
# Probe deadline includes acquisition and SELECT 1; cache 0 disables caching.
# DB_READINESS_TIMEOUT_MS=1000
# DB_READINESS_CACHE_MS=1000
# Startup checks migration history only; it never applies migrations automatically.
# DB_MIGRATION_CHECK_TIMEOUT_MS=5000
# TLS is off for local MySQL. When enabled, require verified chain and host/IP SAN identity, TLS >=1.2.
# Omit CA file to use system trust; a supplied CA file requires DB_SSL=true and valid PEM certificates.
# DB_SSL=false
# Optional CA file (no default): DB_SSL_CA_FILE=/path/to/mysql-ca.pem

# Optional Compose HOST port overrides. Defaults: API 8000; MySQL 3310.
# Integers 1-65535; missing/empty values use defaults. Internal ports stay fixed.
# API_PUBLISHED_PORT=8000
# MYSQL_PUBLISHED_PORT=3310

# Operational endpoints: default true in development/test, false in production.
# Optional overrides; shown values are production defaults. Only true/false accepted.
# Disabled endpoints return 404; enabled endpoints have no application authentication.
# Restrict enabled diagnostics/metrics at the proxy/private-network boundary.
# /health and /ready remain available; readiness never exposes dependency details.
# DOCS_ENABLED=false
# DIAGNOSTICS_ENABLED=false
# METRICS_ENABLED=false

# HTTP policy overrides below are optional; shown values are the code defaults.
# Process environment overrides .env; omit/comment a value to retain its default.
# Lists are comma-separated (not JSON); booleans accept only true/false.
# Empty values are invalid except TRUST_PROXY and CORS header lists, which allow none.

# CORS: exact HTTP(S) origins, including scheme and optional non-default port.
# No wildcards, paths, trailing slash, credentials, query, or fragment. Max 100 origins.
# Use your actual frontend origins in production; this is a localhost default.
# CORS_ORIGINS="http://localhost:3000"
# Uppercase methods; must be a subset of HTTP_ALLOWED_METHODS.
# CORS_METHODS="GET,POST,PUT,DELETE,PATCH,HEAD,OPTIONS"
# Header names are case-insensitive; forwarding/hop-by-hop headers are reserved.
# Allowed request headers also pass through the application's header sanitizer.
# Each header list accepts up to 100 names; empty means no configured headers.
# CORS_ALLOWED_HEADERS="content-type,authorization,x-requested-with"
# Browsers cannot expose Set-Cookie to JavaScript, even when listed here.
# CORS_EXPOSED_HEADERS="authorization,set-cookie"
# CORS_CREDENTIALS=true
# Preflight cache seconds, 0-86400 (zero disables caching).
# CORS_MAX_AGE_SECONDS=86400

# Proxy trust: empty by default; direct peers cannot supply client identity.
# List only actual proxy IPs/CIDRs, comma-separated (max 100); IPv4/IPv6 supported.
# No hostnames, hop counts, wildcard, scoped IPv6, or blanket /0 networks.
# Trusted peers may supply X-Forwarded-For and X-Forwarded-Proto (http/https).
# The rightmost untrusted address identifies the client; other forwarding headers remain blocked.
# The app owns this policy. External Uvicorn commands must also use --no-proxy-headers.
# TRUST_PROXY=""

# Exact rolling-window limits, enforced independently by each API process.
# Optional overrides; shown values are code defaults. Integers only; no blank values.
# Window milliseconds: 1-86400000; max requests: 1-10000; max clients: 1-100000.
# RATE_LIMIT_MAX * RATE_LIMIT_MAX_CLIENTS must not exceed 2000000 timestamp slots.
# Full client quota: 429. New identity at storage capacity: 503. Both include Retry-After.
# Probes, diagnostics, metrics, and preflights share the quota; favicon GET/HEAD is exempt.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_MAX_CLIENTS=10000

# Response/body deadlines in milliseconds; integers 1-2147483647.
# Body-wait deadlines must not exceed the total response deadline.
# These run AFTER HTTP headers are parsed; they are not TCP header-receive deadlines.
# Configure slow-header protection at the selected ingress/server; keep-alive is different.
# REQUEST_TIMEOUT_MS=10000
# REQUEST_FIRST_BODY_TIMEOUT_MS=5000
# REQUEST_CHUNK_TIMEOUT_MS=2000

# Request body bytes: 1-1073741824; default 1048576 (1 MiB).
# HTTP_MAX_BODY_BYTES=1048576
# Raw parsed-header budgets apply before CORS preflight and header sanitization.
# Count: 1-10000. Per-header bytes: 1-1048576. Total bytes: 1-16777216.
# Byte accounting is header name + value; the single-header limit cannot exceed total.
# HTTP_MAX_HEADER_COUNT=100
# HTTP_MAX_SINGLE_HEADER_BYTES=4096
# HTTP_MAX_TOTAL_HEADER_BYTES=8192

# Application method/content-type policies; non-empty comma-separated lists.
# Methods are uppercase and limited to the seven listed here.
# HTTP_ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS"
# Exact media types without parameters/wildcards (max 100); existing body-method rules remain.
# HTTP_ALLOWED_CONTENT_TYPES="application/json,multipart/form-data"

# Shutdown budgets in milliseconds: positive integers; drain must be less than total.
# Stop new HTTP work, drain accepted work, then clean up dependencies.
# HTTP_DRAIN_TIMEOUT_MS=25000
# SHUTDOWN_TIMEOUT_MS=30000
